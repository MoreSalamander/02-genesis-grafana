# Genesis OS — Operational Intelligence configuration.
# With NO variables set the system boots in MOCK mode: telemetry, cognition, and
# actuation run against a deterministic in-process studio scenario, so the full
# OBSERVE→…→VERIFY loop is demonstrable from a clean clone.

# --- Grafana MCP (the runtime partner integration) ---
# Local stack (ops/docker-compose.yml):  http://localhost:8686/mcp
# Grafana Cloud hosted MCP endpoint:     https://<your-stack>.grafana.net/api/mcp  (+ token)
GRAFANA_MCP_URL=
GRAFANA_MCP_TOKEN=
# Datasource UIDs (auto-discovered when unset):
GRAFANA_PROMETHEUS_UID=
GRAFANA_LOKI_UID=

# --- Studio actuation boundary (the simulator's control endpoint) ---
SIMULATOR_CONTROL_URL=http://localhost:9105

# --- Gemini (cognition; API key or Vertex AI env) ---
GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-latest

# --- Storage / behavior ---
GENESIS_DATA_DIR=./data
GENESIS_MOCK=
